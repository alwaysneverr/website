{#
  Shared pieces of MYPROJECT Book 1, used by the index (src/fiction/myproject/book1.njk) and the character pages
  (book1-characters.njk). Import with: {% import "character-book.njk" as cb %}
#}

{# A skill row. Marks: * aura/buff on self, ** can be applied to allies (the document's own legend).
   nested=false leaves out the skill's sub-skills (the character page shows a form's skills beside it instead) #}
{% macro skill(s, nested=true) %}
  {%- if s.label -%}
    <li class="cbook-skills__label">{{ s.label }}</li>
  {%- elif not s.name -%}
    <li class="cbook-skill cbook-skill--empty" aria-label="Empty skill slot"></li>
  {%- else -%}
    <li class="cbook-skill{% if s.code %} cbook-skill--code{% endif %}">
      <div class="cbook-skill__head">
        <span class="cbook-skill__name">{{ s.name }}</span>
        {%- if s.mark %} {{ mark(s.mark) }}{% endif -%}
        {%- for m in s.meta %} <span class="cbook-chip">{{ m }}</span>{% endfor -%}
      </div>
      {%- for t in s.text %}<p class="cbook-skill__text">{{ t }}</p>{% endfor -%}
      {%- if nested and s.children and s.children.length -%}
        <ul class="cbook-skills cbook-skills--sub">{% for c in s.children %}{{ skill(c) }}{% endfor %}</ul>
      {%- endif -%}
    </li>
  {%- endif -%}
{% endmacro %}

{% macro mark(m) %}<abbr class="cbook-mark" title="{{ 'Aura/buff that can be applied to allies' if m == '**' else 'Aura/buff, self only' }}">{{ m }}</abbr>{% endmacro %}

{# A hidden passive: blacked out until opened #}
{% macro hiddenPassive(h) %}
  <details class="cbook-hidden{% if h.code %} cbook-hidden--code{% endif %}">
    <summary><span class="cbook-hidden__label">{{ h.label }}</span><span class="cbook-hidden__bar" aria-hidden="true"></span></summary>
    <p><strong>{{ h.name }}</strong>{% for m in h.meta %} <span class="cbook-chip">{{ m }}</span>{% endfor %}{% if h.text %} – {{ h.text }}{% endif %}</p>
  </details>
{% endmacro %}

{# Lines that are a status rather than a description get a stamp #}
{% macro infoLines(lines) %}
  {%- set stamps = ["Content locked", "(Classified)", "Subject to change", "(Non-combat)", "(Wrote more on this later)", "(More on this later)"] -%}
  {%- for t in lines -%}
    {%- if t in stamps -%}<p class="cbook-stamp">{{ t }}</p>{%- else -%}<p>{{ t | magika | safe }}</p>{%- endif -%}
  {%- endfor -%}
{% endmacro %}

{# The document's own entry: info, quote, members, skills, hidden passives #}
{% macro documentBody(e) %}
  {%- if e.info.length %}<div class="cbook-card__info">{{ infoLines(e.info) }}</div>{% endif -%}
  {%- if e.quote.length -%}
    <blockquote class="cbook-card__quote">{% for q in e.quote %}<p>{{ q }}</p>{% endfor %}</blockquote>
  {%- endif -%}
  {%- if e.attribution %}<p class="cbook-card__attribution">– {{ e.attribution }}</p>{% endif -%}
  {%- if e.children.length -%}
    <ul class="cbook-card__members">{% for c in e.children %}<li>{{ c }}</li>{% endfor %}</ul>
  {%- endif -%}
  {%- if e.skills.length -%}
    <h3 class="cbook-card__subhead">Skills</h3>
    <ul class="cbook-skills">{% for s in e.skills %}{{ skill(s) }}{% endfor %}</ul>
  {%- endif -%}
  {%- for h in e.hidden %}{{ hiddenPassive(h) }}{% endfor -%}
{% endmacro %}

{# The name shown for an entry: the later edit's name when there is one #}
{% macro shownName(e) %}{{ e.edit.name if e.edit else e.name }}{% endmacro %}

{# A name in Ancient Script: the glyphs are hidden from screen readers, which get the plain name instead.
   The script drops the brackets the book puts round deleted entries: "(Ancient Ohm)" is written "Ancient Ohm". #}
{% macro script(name) %}<span class="ancient-script cbook-ancient" aria-hidden="true">{{ name | string | replace('(', '') | replace(')', '') | trim }}</span><span class="cbook-sr">{{ name }}</span>{% endmacro %}

{# Monogram: the first letter or digit of the name #}
{% macro monogram(name) %}{{ name | string | replace('"', '') | replace('(', '') | trim | first }}{% endmacro %}

{# The book's legend, as the document gives it #}
{% macro legend(book) %}
  <div class="cbook__legend">
    <p>{{ mark('*') }} {{ mark('**') }}</p>
    {% for l in book.legend %}<p>{{ l }}</p>{% endfor %}
  </div>
{% endmacro %}

{# The page's picture: the image when one has been added (public/assets/images/myproject/<book>/<id>.<ext>,
   see src/fiction/myproject/images.js), otherwise an empty frame with the monogram, waiting for one #}
{# script: the Ancient ones, whose placeholder letter is in Ancient Script #}
{% macro imageSlot(image, name, script=false) %}
  {%- if image -%}
    <figure class="cbook-figure"><img src="{{ image }}" alt="{{ name }}" loading="lazy" decoding="async"></figure>
  {%- else -%}
    <div class="cbook-figure cbook-figure--empty" aria-hidden="true"><span{% if script %} class="ancient-script"{% endif %}>{{ monogram(name) }}</span></div>
  {%- endif -%}
{% endmacro %}
