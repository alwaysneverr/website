---
layout: base
title: "Book of Original Characters"
description: "MYPROJECT Book 1: Characters. Original characters for the Stickverse, converted from a pencil-written book."
permalink: "/fiction/myproject/book1/"
font: "allerta-stencil"
---

{#
  Book 1 of MYPROJECT: the character book, from the user's own text file (decapitalised, nothing else changed),
  with the later edits from the old site's alphabet pages laid over the Alphabet Heroes. Data: book1.json beside
  this file, made by _local/myproject (parse, decap, build). The Gravity entries are held back until the user
  decides on them, so they're not in the data at all.

  This page lists the names; each character has its own page (book1-characters.njk), like the old site.
  Entries that are only a name (Healers, Trapmakers...) have no page and are listed as plain names.
#}
{% import "character-book.njk" as cb %}
{% set book = book1 %}

{# A chapter's (or group's) names: linked tiles for characters with a page, plain name tags for the rest #}
{% macro names(list) %}
  {% set full = list | rejectattr("bare") %}{% set bare = list | selectattr("bare") %}
  {% if full.length %}
    <ul class="cbook-names">
      {% for e in full %}
        {% set shown = e.edit.name if e.edit else e.name %}
        <li>
          {% set ancient = e.id.startsWith('ancient-') %}
          <a class="cbook-name" href="/fiction/myproject/book1/{{ e.id }}/"{% if ancient %} title="{{ shown }}"{% endif %}>
            <span class="cbook-name__tab{% if ancient %} ancient-script{% endif %}" aria-hidden="true">{{ cb.monogram(shown) }}</span>
            <span class="cbook-name__text">
              <span class="cbook-name__name">{% if ancient %}{{ cb.script(shown) }}{% else %}{{ shown }}{% endif %}</span>
              {% if e.edit and e.edit.power %}<span class="cbook-name__power">{{ e.edit.power }}</span>{% endif %}
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  {% if bare.length %}<ul class="cbook-roster">{% for e in bare %}<li id="{{ e.id }}"{% if e.id.startsWith('ancient-') %} title="{{ e.name }}">{{ cb.script(e.name) }}{% else %}>{{ e.name }}{% endif %}</li>{% endfor %}</ul>{% endif %}
{% endmacro %}

<div class="cbook">
  <nav class="cbook-crumbs cbook-crumbs--return" aria-label="Back to fictions"><a href="/fiction/">← Return</a></nav>
  <header class="cbook__header">
    <p class="cbook__kicker">{{ book.title }} · {{ book.subtitle }}</p>
    <h1 class="cbook__title">Book of Original Characters</h1>
    {{ cb.legend(book) }}
  </header>

  <nav class="cbook__index" aria-label="Chapters">
    <ol>
      {% for s in book.sections %}<li><a href="#{{ s.id }}">{{ s.title }}</a></li>{% endfor %}
    </ol>
  </nav>

  {% for s in book.sections %}
    <section class="cbook-chapter" id="{{ s.id }}" aria-labelledby="{{ s.id }}-title">
      <header class="cbook-chapter__head">
        <span class="cbook-chapter__number" aria-hidden="true">{{ loop.index }}</span>
        <div>
          <h2 class="cbook-chapter__title" id="{{ s.id }}-title">{{ s.title }}</h2>
          {% if s.subtitle %}<p class="cbook-chapter__subtitle">{{ s.subtitle }}</p>{% endif %}
        </div>
      </header>
      {% for p in s.intro %}<p class="cbook-chapter__intro{% if p.startsWith('(') %} cbook-stamp{% endif %}">{{ p }}</p>{% endfor %}

      {% if s.title == "Alphabet Hero" %}
        <nav class="cbook-letters" aria-label="Alphabet heroes">
          <ol>{% for e in s.entries %}{% set shown = e.edit.name if e.edit else e.name %}<li><a href="/fiction/myproject/book1/{{ e.id }}/" title="{{ shown }}">{{ cb.monogram(shown) }}</a></li>{% endfor %}</ol>
        </nav>
      {% endif %}

      {{ names(s.entries) }}
      {% for g in s.groups %}
        <h3 class="cbook-group" id="{{ g.id }}">{{ g.title }}</h3>
        {% for p in g.intro %}<p class="cbook-chapter__intro">{{ p }}</p>{% endfor %}
        {{ names(g.entries) }}
      {% endfor %}
    </section>
  {% endfor %}
</div>
