---
layout: base
---

<article class="container">
  <h1>{{ title }}</h1>
  {%- if images -%}
    <div class="images">
      <img src="{{ images }}" alt="{{ imagesalt }}">
      {%- if images2 -%}
        <img src="{{ images2 }}" alt="{{ images2alt }}">
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="intro-paragraph">
    <div class="column">
      {{ intro | safe }}
    </div>
  </div>

  {{ content | safe }}

  <!-- REPOSITIONED REVIEW METADATA SUMMARY CARD -->
  <section class="review-meta-card" style="--score-color: {{ rating | scoreColor }};">
    <div class="review-meta-card__content">

      {%- if images -%}
      <div class="review-meta-card__gallery">
              
        <div class="review-meta-card__thumb-wrapper">
        <img src="{{ images }}" alt="{{ imagesalt or title }}" class="review-meta-card__image" loading="eager">
        </div>
              
        {%- if images2 -%}
        <div class="review-meta-card__thumb-wrapper">
          <img src="{{ images2 }}" alt="{{ images2alt or title }}" class="review-meta-card__image" loading="lazy">
        </div>
        {%- endif -%}

        </div>
      {%- endif -%}
          
      <!-- Left Column: Contextual Series Registry Details -->
      {%- if series or media -%}
      <div class="review-meta-card__details">
        <span class="review-meta-card__details-label">Series</span>
        <p class="review-meta-card__series-title"><b>{{ series }}</b></p>
        <span class="review-meta-card__media-badge">{{ media }}</span>
      </div>
      {%- endif -%}

      <!-- Right Column: Primary Rating Score Metric -->
      <div class="review-meta-card__score-box">
        <span class="review-meta-card__score-label">Rating</span>
        <span class="review-meta-card__score-value">★ {{ rating }}/10</span>
        {%- if ratingaddon -%}
          <div class="review-meta-card__addon">{{ ratingaddon | safe }}</div>
        {%- endif -%}
      </div>

    </div>
  </section>

<!-- AUTOMATION: PREVIOUS & NEXT ROUTING ENGINE WITH DYNAMIC COLORS -->
{%- if collections.reviews -%}
  {%- set previousPost = collections.reviews | getPreviousCollectionItem(page) -%}
  {%- set nextPost = collections.reviews | getNextCollectionItem(page) -%}

  {%- if previousPost or nextPost -%}
    <nav class="review-pagination" aria-label="Review Navigation">
      
      <!-- Left Slot: Older Review Link -->
      <div class="review-pagination__slot review-pagination__slot--prev">
        {%- if previousPost -%}
          <a id="prev-review-link" href="{{ previousPost.url | url }}" style="--media-color: {{ previousPost.data.media | mediaColor }};">
            <span class="review-pagination__label">← Older Review</span>
            <span class="review-pagination__title">
              {{ previousPost.data.title }}
            </span>
          </a>
        {%- endif -%}
      </div>

      <!-- Right Slot: Newer Review Link -->
      <div class="review-pagination__slot review-pagination__slot--next">
        {%- if nextPost -%}
          <a id="next-review-link" href="{{ nextPost.url | url }}" style="--media-color: {{ nextPost.data.media | mediaColor }};">
            <span class="review-pagination__label">Newer Review →</span>
            <span class="review-pagination__title">
              {{ nextPost.data.title }}
            </span>
          </a>
        {%- endif -%}
      </div>

    </nav>
  {%- endif -%}
{%- endif -%}

</article>

