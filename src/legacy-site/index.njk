<!-- 3. INTERACTION AND SYSTEM SYNCHRONIZATION EVENT LISTENERS -->
<script>
  // Safe validation check to make sure your button listener doesn't throw a crash null error
  const legacyBtn = document.querySelector('.old-homepage button');
  if (legacyBtn) {
    legacyBtn.addEventListener('click', () => {
      window.location.href = '/legacy-site/index2.html';
    });
  }

  // Forces your modern horizontal header dropdown element block to show the right environment state selection track
  document.addEventListener('DOMContentLoaded', () => {
    const envSelector = document.querySelector('#site-version-select');
    if (envSelector) {
      envSelector.value = "/legacy-site/";
    }
  });
</script>