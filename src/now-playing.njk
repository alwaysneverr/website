---
layout: base
title: Now Playing
description: What I'm currently consuming — full matrix and artwork.
permalink: "/now-playing/"
---

<div class="container">
  <section class="media-matrix-section" style="margin: var(--step-2, 24px) 0 var(--step-4, 48px) 0;">
    
    <header class="matrix-header" style="margin-bottom: var(--step-0, 16px); display: flex; align-items: center; gap: 8px;">
      <span style="font-family: monospace; font-size: 0.65rem; background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.25); padding: 2px 6px; border-radius: 4px; font-weight: 700;">SYSTEM_MONITOR</span>
      <h2 style="margin: 0; font-size: var(--step-0, 1.1rem); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 800; color: var(--text-main);">Active Consumption Track Matrix</h2>
    </header>

    <div class="media-matrix-grid">
      {% for item in nowPlaying %}
        
        {# Safely evaluate progress bar percentage math values #}
        {% if item.total == "ongoing" %}
          {% set progressPercent = 100 %}
          {% set progressMode = "ongoing" %}
        {% else %}
          {% set progressPercent = (item.current / item.total) * 100 %}
          {% set progressMode = "finite" %}
        {% endif %}

        <div class="matrix-card" style="--card-accent: {{ item.accentColor }};">
          
          <!-- POSTER COVER ELEMENT CONTAINER -->
          {% if item.coverImage %}
          <div class="matrix-card__poster-wrapper">
            <img src="{{ item.coverImage }}" class="matrix-card__image" alt="Poster art for {{ item.title }}" loading="lazy">
          </div>
          {% endif %}
          
          <div class="matrix-card__content">
            <div class="matrix-card__header">
              <span class="matrix-card__status">{{ item.status }}</span>
              <span class="matrix-card__badge" data-tag-type="{{ item.type }}">{{ item.type }}</span>
            </div>
            
            <h3 class="matrix-card__title">{{ item.title }}</h3>
            <p class="matrix-card__meta">{{ item.meta }}</p>
            
            <!-- FLEXIBLE SYSTEM TRACK TRACKER -->
            <div class="matrix-card__progress-container" data-progress-style="{{ progressMode }}">
              <div class="matrix-card__progress-bar" style="width: {{ progressPercent }}%;"></div>
            </div>
          </div>
          
        </div>
      {% endfor %}
    </div>

  </section>
</div>
